# Copy to .env and fill values.

# Cloud AI model (OpenAI)
OPENAI_API_KEY=REPLACE_ME
OPENAI_MODEL=gpt-4o-mini

# Google Drive sync (rclone)
RCLONE_REMOTE=gdrive
DRIVE_ROOT=AI-Radio

# Optional overrides used by termux/ai_radio_run.sh
# BOOKMARKS_PATH=~/storage/downloads/AI-Radio/bookmarks.html
# LINKS_PATH=~/storage/downloads/AI-Radio/links.txt
# INPUT_DIR=~/storage/downloads/AI-Radio/inputs
# MAX_ITEMS=50
# UPLOAD_TO_DRIVE=1
# DRY_RUN_UPLOAD=1
